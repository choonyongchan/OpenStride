# Copy to .env and fill in. Only the first two are required.
OPENSTRIDE_CLUB_ID=123456                 # the number in strava.com/clubs/<id>
OPENSTRIDE_CHALLENGE_START=2026-09-14     # local date; activities before it don't count

OPENSTRIDE_CLUB_NAME=My Running Club      # shown on the dashboard (default "Club <id>")
OPENSTRIDE_TIMEZONE=Asia/Singapore        # IANA zone: when days and weeks start (default UTC)
OPENSTRIDE_SPORTS=Run,TrailRun,VirtualRun,Walk,Hike   # sport types that count; match the club's leaderboard sport
OPENSTRIDE_SYNC_MINUTES=60                # light sync interval; 0 = only on demand
OPENSTRIDE_SCAN_HOUR=23                   # local hour of the nightly profile scan; "off" to disable
OPENSTRIDE_API_TOKEN=                     # set to enable /api/v3/clubs/* and POST /api/sync (send as Bearer token)
# OPENSTRIDE_DATA_DIR=/data               # where the CSVs and the session live (the image sets /data)
# OPENSTRIDE_SESSION_FILE=/data/auth_state.json
# OPENSTRIDE_HEADLESS=true
# OPENSTRIDE_BROWSER_CHANNEL=             # "" = bundled Chromium; "chrome" / "msedge" for an installed browser
